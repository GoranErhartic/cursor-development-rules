## Business Rules

### Listing Business Rules

```typescript
// src/domain/rules/listing.rules.ts

import type { Listing } from "../entities/listing.entity";
import type { Property } from "../entities/property.entity";
import { Result } from "@/shared/result";

export function canPublishListing(
  listing: Listing,
  property: Property,
  existingActiveListings: Listing[]
): Result<void> {
  // Rule: Only draft listings can be published
  if (listing.status !== "draft") {
    return Result.fail({
      code: "INVALID_LISTING_STATUS",
      message: "Only draft listings can be published",
      statusCode: 400,
    });
  }

  // Rule: Property must not have another active listing of the same type
  const hasActiveOfSameType = existingActiveListings.some(
    (l) => l.listingType === listing.listingType && l.status === "active"
  );

  if (hasActiveOfSameType) {
    return Result.fail({
      code: "DUPLICATE_ACTIVE_LISTING",
      message: `Property already has an active ${listing.listingType} listing`,
      statusCode: 409,
    });
  }

  // Rule: Price must be reasonable (not 0 or negative)
  if (listing.price <= 0) {
    return Result.fail({
      code: "INVALID_PRICE",
      message: "Price must be greater than 0",
      statusCode: 400,
    });
  }

  // Rule: Must have at least one photo
  if (listing.photos.length === 0) {
    return Result.fail({
      code: "NO_PHOTOS",
      message: "Listing must have at least one photo",
      statusCode: 400,
    });
  }

  return Result.ok(undefined);
}

export function canUpdatePrice(
  listing: Listing,
  newPrice: number
): Result<void> {
  // Rule: Only active listings can have price changes
  if (listing.status !== "active") {
    return Result.fail({
      code: "LISTING_NOT_ACTIVE",
      message: "Only active listings can have price changes",
      statusCode: 400,
    });
  }

  // Rule: Price change must be different
  if (listing.price === newPrice) {
    return Result.fail({
      code: "NO_PRICE_CHANGE",
      message: "New price must be different from current price",
      statusCode: 400,
    });
  }

  // Rule: Price must be positive
  if (newPrice <= 0) {
    return Result.fail({
      code: "INVALID_PRICE",
      message: "Price must be greater than 0",
      statusCode: 400,
    });
  }

  return Result.ok(undefined);
}

export function canMarkAsSold(
  listing: Listing,
  soldPrice: number
): Result<void> {
  // Rule: Must be active or pending
  if (listing.status !== "active" && listing.status !== "pending") {
    return Result.fail({
      code: "INVALID_LISTING_STATUS",
      message: "Only active or pending listings can be marked as sold",
      statusCode: 400,
    });
  }

  // Rule: Sold price must be positive
  if (soldPrice <= 0) {
    return Result.fail({
      code: "INVALID_SOLD_PRICE",
      message: "Sold price must be greater than 0",
      statusCode: 400,
    });
  }

  return Result.ok(undefined);
}
```

### Lead Business Rules

```typescript
// src/domain/rules/lead.rules.ts

import type { Lead } from "../entities/lead.entity";
import type { Listing } from "../entities/listing.entity";
import { Result } from "@/shared/result";

export function canCaptureLead(
  propertyId: string,
  email: string,
  existingLeads: Lead[],
  activeListing: Listing | null
): Result<void> {
  // Rule: Property must have active listing
  if (!activeListing || activeListing.status !== "active") {
    return Result.fail({
      code: "NO_ACTIVE_LISTING",
      message: "Property does not have an active listing",
      statusCode: 400,
    });
  }

  // Rule: No duplicate leads from same email within 24 hours
  const recentFromSameEmail = existingLeads.find((lead) => {
    const hoursSinceCreation = 
      (Date.now() - new Date(lead.createdAt).getTime()) / (1000 * 60 * 60);
    return (
      lead.contact.email.toLowerCase() === email.toLowerCase() &&
      hoursSinceCreation < 24
    );
  });

  if (recentFromSameEmail) {
    return Result.fail({
      code: "DUPLICATE_LEAD",
      message: "A lead from this email was already captured in the last 24 hours",
      statusCode: 409,
    });
  }

  return Result.ok(undefined);
}

export function canScheduleViewing(
  lead: Lead,
  scheduledAt: Date
): Result<void> {
  // Rule: Lead must be at least contacted
  if (lead.status === "new") {
    return Result.fail({
      code: "LEAD_NOT_CONTACTED",
      message: "Lead must be contacted before scheduling a viewing",
      statusCode: 400,
    });
  }

  // Rule: Viewing must be in the future
  if (scheduledAt <= new Date()) {
    return Result.fail({
      code: "INVALID_VIEWING_TIME",
      message: "Viewing must be scheduled in the future",
      statusCode: 400,
    });
  }

  // Rule: Viewing must be during business hours (9 AM - 8 PM)
  const hour = scheduledAt.getHours();
  if (hour < 9 || hour >= 20) {
    return Result.fail({
      code: "OUTSIDE_BUSINESS_HOURS",
      message: "Viewings can only be scheduled between 9 AM and 8 PM",
      statusCode: 400,
    });
  }

  return Result.ok(undefined);
}
```

## Value Objects

```typescript
// src/domain/value-objects/money.ts

export class Money {
  private constructor(
    public readonly amount: number,
    public readonly currency: string = "USD"
  ) {}

  static create(amount: number, currency: string = "USD"): Money {
    if (amount < 0) {
      throw new Error("Money amount cannot be negative");
    }
    return new Money(Math.round(amount * 100) / 100, currency);
  }

  add(other: Money): Money {
    this.ensureSameCurrency(other);
    return Money.create(this.amount + other.amount, this.currency);
  }

  subtract(other: Money): Money {
    this.ensureSameCurrency(other);
    return Money.create(this.amount - other.amount, this.currency);
  }

  multiply(factor: number): Money {
    return Money.create(this.amount * factor, this.currency);
  }

  percentageOf(percentage: number): Money {
    return Money.create(this.amount * (percentage / 100), this.currency);
  }

  equals(other: Money): boolean {
    return this.amount === other.amount && this.currency === other.currency;
  }

  format(): string {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: this.currency,
    }).format(this.amount);
  }

  private ensureSameCurrency(other: Money): void {
    if (this.currency !== other.currency) {
      throw new Error("Cannot operate on money with different currencies");
    }
  }
}
```

## Conventions

- Use past tense for event names (PropertyCreated, ListingSold)
- Domain events contain only data, no behavior
- Business rules return Result<T> for validation
- Entities have factory functions for creation
- Value objects are immutable
- Aggregate roots control access to child entities
- Events are published after successful state changes
- Idempotency keys include entity ID and timestamp

## Anti-Patterns

- ❌ Publishing events before database commit
- ❌ Mutable domain objects
- ❌ Business logic in handlers (put in domain layer)
- ❌ Direct database access from handlers
- ❌ Event payloads with sensitive data
- ❌ Events that don't capture full state change
- ❌ Circular dependencies between aggregates

