## Domain Events

### Event Types

```typescript
// src/domain/events/types.ts

export interface DomainEvent<T = unknown> {
  eventId: string;
  eventType: string;
  aggregateType: string;
  aggregateId: string;
  version: number;
  timestamp: string;
  correlationId: string;
  causationId?: string;
  metadata: {
    source: string;
    userId?: string;
    traceId?: string;
  };
  payload: T;
}
```

### Property Events

```typescript
// src/domain/events/property.events.ts

import type { DomainEvent } from "./types";
import type { Address, PropertyType } from "../entities/property.entity";

// Event payloads
export interface PropertyCreatedPayload {
  propertyId: string;
  address: Address;
  propertyType: PropertyType;
  bedrooms: number;
  bathrooms: number;
  squareFeet: number;
  yearBuilt?: number;
  features: string[];
  ownerId: string;
}

export interface PropertyUpdatedPayload {
  propertyId: string;
  changes: Record<string, { old: unknown; new: unknown }>;
