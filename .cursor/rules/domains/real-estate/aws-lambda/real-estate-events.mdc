## Event Publishers

```typescript
// src/domain/events/publisher.ts

import { randomUUID } from "node:crypto";
import { publishEvent } from "@/shared/sns/publisher";
import type { DomainEvent } from "./types";
import { logger } from "@/shared/logger";

const PROPERTY_EVENTS_TOPIC = process.env.PROPERTY_EVENTS_TOPIC_ARN!;
const LISTING_EVENTS_TOPIC = process.env.LISTING_EVENTS_TOPIC_ARN!;
const LEAD_EVENTS_TOPIC = process.env.LEAD_EVENTS_TOPIC_ARN!;

export async function publishPropertyEvent<T>(
  eventType: string,
  propertyId: string,
  payload: T,
  options: { correlationId?: string; userId?: string } = {}
): Promise<string> {
  const event = createDomainEvent(
    eventType,
    "Property",
    propertyId,
    payload,
    options
  );

  logger.info({ eventType, propertyId }, "Publishing property event");

  return publishEvent(PROPERTY_EVENTS_TOPIC, event);
}

export async function publishListingEvent<T>(
  eventType: string,
  listingId: string,
  payload: T,
  options: { correlationId?: string; userId?: string } = {}
): Promise<string> {
  const event = createDomainEvent(
    eventType,
    "Listing",
    listingId,
    payload,
    options
  );

  logger.info({ eventType, listingId }, "Publishing listing event");

  return publishEvent(LISTING_EVENTS_TOPIC, event);
}

export async function publishLeadEvent<T>(
  eventType: string,
  leadId: string,
  payload: T,
  options: { correlationId?: string; userId?: string } = {}
): Promise<string> {
  const event = createDomainEvent(
    eventType,
    "Lead",
    leadId,
    payload,
    options
  );

  logger.info({ eventType, leadId }, "Publishing lead event");

  return publishEvent(LEAD_EVENTS_TOPIC, event);
}

function createDomainEvent<T>(
  eventType: string,
  aggregateType: string,
  aggregateId: string,
  payload: T,
  options: { correlationId?: string; userId?: string; causationId?: string }
): DomainEvent<T> {
  return {
    eventId: randomUUID(),
    eventType,
    aggregateType,
    aggregateId,
    version: 1,
    timestamp: new Date().toISOString(),
    correlationId: options.correlationId ?? randomUUID(),
    causationId: options.causationId,
    metadata: {
      source: process.env.SERVICE_NAME ?? "real-estate-api",
      userId: options.userId,
      traceId: process.env._X_AMZN_TRACE_ID,
    },
    payload,
  };
}
```


