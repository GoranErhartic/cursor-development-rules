## Test Structure (AAA Pattern)

```java
@ExtendWith(MockitoExtension.class)
class SearchContainersQueryHandlerTest {
    
    @Mock
    private Map<ExternalApiProvider, ContainerSearchStrategy> strategies;
    
    @Mock
    private ContainerSearchStrategy eModalStrategy;
    
    @InjectMocks
    private SearchContainersQueryHandler handler;
    
    @Test
    void handle_shouldReturnResults_whenStrategyFindsContainers() {
        // Arrange
        var query = new SearchContainersQuery(
            ExternalApiProvider.EMODAL, 
            "MSCU1234567", 
            TradeType.IMPORT
        );
        var expectedResults = List.of(
            new ContainerSearchResult("MSCU1234567", "AVAILABLE")
        );
        
        when(strategies.get(ExternalApiProvider.EMODAL)).thenReturn(eModalStrategy);
        when(eModalStrategy.search("MSCU1234567", TradeType.IMPORT))
            .thenReturn(Result.success(expectedResults));
        
        // Act
        var result = handler.handle(query);
        
        // Assert
        assertThat(result.isSuccess()).isTrue();
        assertThat(result).isInstanceOf(Result.Success.class);
        
        var success = (Result.Success<List<ContainerSearchResult>>) result;
        assertThat(success.value()).hasSize(1);
        assertThat(success.value().get(0).containerNumber()).isEqualTo("MSCU1234567");
    }
    
    @Test
    void handle_shouldReturnFailure_whenBackendNotSupported() {
        // Arrange
        var query = new SearchContainersQuery(
            ExternalApiProvider.EMODAL, 
            "MSCU1234567", 
            TradeType.IMPORT
        );
        
        when(strategies.get(any())).thenReturn(null);
        
        // Act
        var result = handler.handle(query);
        
        // Assert
        assertThat(result.isFailure()).isTrue();
        
        var failure = (Result.Failure<List<ContainerSearchResult>>) result;
        assertThat(failure.error().code()).isEqualTo("Backend.Unsupported");
    }
}
```

## Naming Convention

```
{methodName}_should{ExpectedBehavior}_when{Condition}
```

Examples:
- `handle_shouldReturnSuccess_whenContainerFound`
- `handle_shouldReturnFailure_whenBackendUnavailable`
- `dispatch_shouldRouteToCorrectHandler_whenQueryProvided`

## Web Layer Tests (MockMvc)

```java
@WebMvcTest(ContainerSearchController.class)
@Import({NoAuthSecurityConfig.class})
class ContainerSearchControllerTest {
    
    @Autowired
    private MockMvc mockMvc;
    
    @MockitoBean
    private Dispatcher dispatcher;
    
    @Test
    void searchContainers_shouldReturnResults_whenContainerFound() throws Exception {
        // Arrange
        var results = List.of(
            new ContainerSearchResult("MSCU1234567", "AVAILABLE")
        );
        
        when(dispatcher.dispatch(any(SearchContainersQuery.class)))
            .thenReturn(Result.success(results));
        
        // Act & Assert
        mockMvc.perform(get("/api/bff/containers/search/EMODAL")
                .param("q", "MSCU1234567"))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.results").isArray())
            .andExpect(jsonPath("$.results[0].containerNumber").value("MSCU1234567"));
    }
    
    @Test
    void searchContainers_shouldReturn400_whenContainerNumberInvalid() throws Exception {
        // Act & Assert
        mockMvc.perform(get("/api/bff/containers/search/EMODAL")
                .param("q", ""))
            .andExpect(status().isBadRequest());
    }
    
    @Test
    void searchContainers_shouldReturn400_whenBackendInvalid() throws Exception {
        // Act & Assert
        mockMvc.perform(get("/api/bff/containers/search/INVALID_BACKEND")
                .param("q", "MSCU1234567"))
            .andExpect(status().isBadRequest())
            .andExpect(jsonPath("$.errors").exists());
    }
}
```

## HTTP Client Testing with WireMock

```java
@SpringBootTest
@ActiveProfiles("test")
class EModalClientIntegrationTest {
    
    private WireMockServer wireMockServer;
    private EModalClient eModalClient;
    
    @BeforeEach
    void setUp() {
        wireMockServer = new WireMockServer(WireMockConfiguration.options()
            .dynamicPort());
        wireMockServer.start();
        
        var restClient = RestClient.builder()
            .baseUrl(wireMockServer.baseUrl())
            .build();
        
        var factory = HttpServiceProxyFactory
            .builderFor(RestClientAdapter.create(restClient))
            .build();
        
        eModalClient = factory.createClient(EModalClient.class);
    }
    
    @AfterEach
    void tearDown() {
        wireMockServer.stop();
    }
    
    @Test
    void getContainerFeeInventory_shouldReturnResults() {
        // Arrange
        wireMockServer.stubFor(get(urlPathEqualTo("/datahub/fee/containerfeeinventory/MSCU1234567/I"))
            .willReturn(aResponse()
                .withStatus(200)
                .withHeader("Content-Type", "application/json")
                .withBody("""
                    [{
                        "drayUnitId": "123e4567-e89b-12d3-a456-426614174000",
                        "containerNumber": "MSCU1234567",
                        "status": "AVAILABLE"
                    }]
                    """)));
        
        // Act
        var results = eModalClient.getContainerFeeInventory("MSCU1234567", "I");
        
        // Assert
        assertThat(results).hasSize(1);
        assertThat(results.get(0).containerNumber()).isEqualTo("MSCU1234567");
        
        // Verify request was made
        wireMockServer.verify(getRequestedFor(
            urlPathEqualTo("/datahub/fee/containerfeeinventory/MSCU1234567/I")));
    }
    
    @Test
    void getContainerFeeInventory_shouldHandleEmptyResponse() {
        // Arrange
        wireMockServer.stubFor(get(urlPathMatching("/datahub/fee/containerfeeinventory/.*"))
            .willReturn(aResponse()
                .withStatus(200)
                .withHeader("Content-Type", "application/json")
                .withBody("[]")));
        
        // Act
        var results = eModalClient.getContainerFeeInventory("NOTFOUND123", "I");
        
        // Assert
        assertThat(results).isEmpty();
    }
}
```

## Architecture Tests (ArchUnit)

```java
@AnalyzeClasses(packages = "com.cargosprint.bff", importOptions = ImportOption.DoNotIncludeTests.class)
class CleanArchitectureTest {

    private static final String BASE_PACKAGE = "com.cargosprint.bff";
    
    @ArchTest
    static final ArchRule layered_architecture_should_be_respected = layeredArchitecture()
        .consideringOnlyDependenciesInLayers()
        .layer("Domain").definedBy(BASE_PACKAGE + ".domain..")
        .layer("Application").definedBy(BASE_PACKAGE + ".application..")
        .layer("Infrastructure").definedBy(BASE_PACKAGE + ".infrastructure..")
        .layer("Web").definedBy(BASE_PACKAGE + ".web..")
        .whereLayer("Domain").mayNotAccessAnyLayer()
        .whereLayer("Application").mayOnlyAccessLayers("Domain")
        .whereLayer("Infrastructure").mayOnlyAccessLayers("Application", "Domain")
        .whereLayer("Web").mayOnlyAccessLayers("Application", "Domain", "Infrastructure");

    @ArchTest
    static final ArchRule domain_should_not_use_spring = noClasses()
        .that().resideInAPackage(BASE_PACKAGE + ".domain..")
        .should().dependOnClassesThat()
        .resideInAnyPackage("org.springframework..", "jakarta.servlet..");

    @ArchTest
    static final ArchRule controllers_should_not_depend_on_handlers = noClasses()
        .that().resideInAPackage(BASE_PACKAGE + ".web.controller..")
        .and().haveSimpleNameEndingWith("Controller")
        .should().dependOnClassesThat().haveSimpleNameEndingWith("Handler");

    @ArchTest
    static final ArchRule controllers_should_not_depend_on_ports = noClasses()
        .that().resideInAPackage(BASE_PACKAGE + ".web.controller..")
        .should().dependOnClassesThat().haveSimpleNameEndingWith("Port");

    @ArchTest
    static final ArchRule features_should_not_depend_on_each_other = slices()
        .matching(BASE_PACKAGE + ".application.features.(*)..")
        .should().notDependOnEachOther();

    @ArchTest
    static final ArchRule no_field_injection = noClasses()
        .that().resideInAPackage(BASE_PACKAGE + "..")
        .should().beAnnotatedWith(org.springframework.beans.factory.annotation.Autowired.class);
}
```

