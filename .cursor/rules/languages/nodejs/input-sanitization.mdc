# Input Sanitization

## Overview

Sanitization is different from validation:
- **Validation** checks if input meets requirements (reject if invalid)
- **Sanitization** cleans/transforms input to be safe (modify to be safe)

Apply both: validate first, then sanitize if needed.

## XSS Prevention

### HTML Sanitization

```typescript
// src/shared/utils/sanitize.ts

import DOMPurify from "isomorphic-dompurify";
import sanitizeHtml from "sanitize-html";

// For user-generated HTML content (rich text editors)
export function sanitizeHtmlContent(dirty: string): string {
  return sanitizeHtml(dirty, {
    allowedTags: [
      "b", "i", "em", "strong", "a", "p", "br", "ul", "ol", "li",
      "h1", "h2", "h3", "h4", "h5", "h6", "blockquote", "code", "pre"
    ],
    allowedAttributes: {
      a: ["href", "title", "target"],
    },
    allowedSchemes: ["http", "https", "mailto"],
    // Prevent javascript: URLs
    allowedSchemesByTag: {
      a: ["http", "https", "mailto"],
    },
  });
}

// Using DOMPurify (lighter, browser-compatible)
export function sanitizeWithDOMPurify(dirty: string): string {
  return DOMPurify.sanitize(dirty, {
    ALLOWED_TAGS: ["b", "i", "em", "strong", "a", "p", "br"],
    ALLOWED_ATTR: ["href", "title"],
  });
}

// Strip all HTML tags
export function stripHtml(input: string): string {
  return DOMPurify.sanitize(input, { ALLOWED_TAGS: [] });
}
```

### Text Output Encoding

```typescript
// For rendering user input in HTML context
import { encode } from "html-entities";

export function encodeForHtml(input: string): string {
  return encode(input);
}

// Usage in templates
const userComment = encodeForHtml(req.body.comment);
// <script> becomes &lt;script&gt;
```

### JSON Response Safety

```typescript
// Express automatically handles JSON encoding
// But be careful with res.send() for HTML responses

// SAFE - JSON responses encode automatically
res.json({ message: userInput }); // XSS-safe

// DANGEROUS - Direct HTML response
res.send(`<div>${userInput}</div>`); // XSS vulnerable!

// SAFE - Encode for HTML
import { encode } from "html-entities";
res.send(`<div>${encode(userInput)}</div>`);
```

## SQL Injection Prevention

### Parameterized Queries (Always Use)

```typescript
// Prisma - Safe by default
const user = await prisma.user.findUnique({
  where: { email: userInput }, // Automatically parameterized
});

// Drizzle - Safe by default
const user = await db.query.users.findFirst({
  where: eq(users.email, userInput), // Parameterized
});

// Raw SQL with Prisma - Use $queryRaw with template literals
const users = await prisma.$queryRaw`
  SELECT * FROM users WHERE email = ${userInput}
`; // Safe - parameterized

// DANGEROUS - String concatenation
const users = await prisma.$queryRawUnsafe(
  `SELECT * FROM users WHERE email = '${userInput}'`
); // SQL INJECTION VULNERABLE!
```

### Dynamic Queries

```typescript
// Safe dynamic column selection
const allowedColumns = ["name", "email", "createdAt"] as const;
type AllowedColumn = (typeof allowedColumns)[number];

function isAllowedColumn(col: string): col is AllowedColumn {
  return allowedColumns.includes(col as AllowedColumn);
}

function buildOrderBy(column: string, direction: "asc" | "desc") {
  if (!isAllowedColumn(column)) {
    throw new Error("Invalid column");
  }
  // Now safe to use in query
  return { [column]: direction };
}

// Safe dynamic filtering
const filters: Record<string, unknown> = {};
if (req.query.status && ["active", "inactive"].includes(req.query.status)) {
  filters.status = req.query.status;
}
```

## Path Traversal Prevention

```typescript
// src/shared/utils/file-utils.ts

import path from "node:path";
import { stat } from "node:fs/promises";

const UPLOAD_DIR = path.resolve("/app/uploads");

export function sanitizeFilePath(userPath: string): string {
  // Remove null bytes
  const cleaned = userPath.replace(/\0/g, "");
  
  // Get just the filename, remove any directory components
  const filename = path.basename(cleaned);
  
  // Remove any remaining path traversal attempts
  return filename.replace(/\.\./g, "");
}

export async function getSecureFilePath(
  filename: string
): Promise<string | null> {
  const sanitized = sanitizeFilePath(filename);
  const fullPath = path.join(UPLOAD_DIR, sanitized);
  
  // Verify the resolved path is still within UPLOAD_DIR
  const resolved = path.resolve(fullPath);
  if (!resolved.startsWith(UPLOAD_DIR)) {
    return null; // Path traversal attempt
  }
  
  // Verify file exists
  try {
    await stat(resolved);
    return resolved;
  } catch {
    return null;
  }
}

// Usage
router.get("/files/:filename", async (req, res) => {
  const filePath = await getSecureFilePath(req.params.filename);
  
  if (!filePath) {
    res.status(404).json({ error: "File not found" });
    return;
  }
  
  res.sendFile(filePath);
});
```

## Content-Type Validation

```typescript
// src/shared/middleware/content-type.ts

import type { Request, Response, NextFunction } from "express";
import { fileTypeFromBuffer } from "file-type";

// Validate Content-Type header
export function requireContentType(allowedTypes: string[]) {
  return (req: Request, res: Response, next: NextFunction): void => {
    const contentType = req.headers["content-type"]?.split(";")[0];
    
    if (!contentType || !allowedTypes.includes(contentType)) {
      res.status(415).json({
        type: "https://api.example.com/errors/unsupported-media-type",
        title: "Unsupported Media Type",
        status: 415,
        detail: `Content-Type must be one of: ${allowedTypes.join(", ")}`,
      });
      return;
    }
    
    next();
  };
}

// Validate file upload magic bytes
export async function validateFileType(
  buffer: Buffer,
  allowedMimeTypes: string[]
): Promise<boolean> {
  const type = await fileTypeFromBuffer(buffer);
  
  if (!type) {
    return false;
  }
  
  return allowedMimeTypes.includes(type.mime);
}

// Usage with multer
import multer from "multer";

const upload = multer({
  limits: {
    fileSize: 5 * 1024 * 1024, // 5MB
  },
  fileFilter: async (req, file, cb) => {
    // Check extension
    const allowedExtensions = [".jpg", ".jpeg", ".png", ".gif"];
    const ext = path.extname(file.originalname).toLowerCase();
    
    if (!allowedExtensions.includes(ext)) {
      cb(new Error("Invalid file extension"));
      return;
    }
    
    cb(null, true);
  },
});

// Validate after upload
router.post("/upload", upload.single("image"), async (req, res) => {
  if (!req.file) {
    res.status(400).json({ error: "No file uploaded" });
    return;
  }
  
  // Validate magic bytes
  const isValid = await validateFileType(req.file.buffer, [
    "image/jpeg",
    "image/png",
    "image/gif",
  ]);
  
  if (!isValid) {
    res.status(400).json({ error: "Invalid file type" });
    return;
  }
  
  // Process file...
});
```

## NoSQL Injection Prevention

```typescript
// MongoDB query injection prevention

// DANGEROUS - User input directly in query
const user = await db.collection("users").findOne({
  email: req.body.email, // Could be { $ne: "" } - returns first user!
});

// SAFE - Validate and coerce types
import { z } from "zod";

const loginSchema = z.object({
  email: z.string().email(), // Must be string
  password: z.string(),
});

const parsed = loginSchema.parse(req.body);
const user = await db.collection("users").findOne({
  email: parsed.email, // Guaranteed to be string
});

// SAFE - Explicit type checking
function sanitizeMongoQuery<T>(input: unknown): T | null {
  if (typeof input === "object" && input !== null) {
    // Reject objects with $ operators
    const hasOperator = Object.keys(input).some((key) => key.startsWith("$"));
    if (hasOperator) {
      return null;
    }
  }
  return input as T;
}
```

## Command Injection Prevention

```typescript
// NEVER interpolate user input into shell commands

// DANGEROUS
import { exec } from "node:child_process";
exec(`ls ${userInput}`); // Command injection!

// SAFE - Use execFile with arguments array
import { execFile } from "node:child_process";
execFile("ls", [userInput], (error, stdout) => {
  // Arguments are properly escaped
});

// SAFE - Use spawn with arguments array
import { spawn } from "node:child_process";
const ls = spawn("ls", ["-la", sanitizedPath]);

// Better - Avoid shell commands entirely
import { readdir } from "node:fs/promises";
const files = await readdir(sanitizedPath);
```

## Sanitization Middleware

```typescript
// src/shared/middleware/sanitize.ts

import type { Request, Response, NextFunction } from "express";
import { stripHtml } from "@/shared/utils/sanitize";

// Recursively sanitize object values
function sanitizeObject(obj: unknown): unknown {
  if (typeof obj === "string") {
    return stripHtml(obj).trim();
  }
  
  if (Array.isArray(obj)) {
    return obj.map(sanitizeObject);
  }
  
  if (obj !== null && typeof obj === "object") {
    const sanitized: Record<string, unknown> = {};
    for (const [key, value] of Object.entries(obj)) {
      sanitized[key] = sanitizeObject(value);
    }
    return sanitized;
  }
  
  return obj;
}

export function sanitizeBody(req: Request, res: Response, next: NextFunction): void {
  if (req.body) {
    req.body = sanitizeObject(req.body);
  }
  next();
}

// Apply selectively to routes that need it
router.post("/comments", sanitizeBody, validateBody(commentSchema), createComment);
```

## Zod Sanitization Transforms

```typescript
// Combine validation with sanitization
import { z } from "zod";

const commentSchema = z.object({
  // Trim whitespace and limit length
  content: z
    .string()
    .trim()
    .min(1, "Content is required")
    .max(1000, "Content too long")
    .transform((val) => stripHtml(val)), // Sanitize HTML
  
  // Normalize email
  email: z
    .string()
    .email()
    .toLowerCase()
    .trim(),
  
  // Remove dangerous characters from filename
  filename: z
    .string()
    .transform((val) => val.replace(/[^a-zA-Z0-9._-]/g, "")),
});
```

## Conventions

- Validate input at API boundaries (controllers)
- Sanitize only when necessary (user-generated HTML)
- Use parameterized queries ALWAYS
- Never trust client-side validation alone
- Validate file types by magic bytes, not just extension
- Escape output based on context (HTML, URL, SQL)
- Use allowlists over blocklists
- Log sanitization actions for security auditing

## Anti-Patterns

- ❌ Using blocklists to filter dangerous patterns
- ❌ String concatenation in SQL queries
- ❌ Trusting Content-Type headers without validation
- ❌ Using `eval()` or `new Function()` with user input
- ❌ Interpolating user input into shell commands
- ❌ Allowing arbitrary file paths from user input
- ❌ Sanitizing after database storage (sanitize on input)
- ❌ Disabling sanitization for "trusted" users

**See also:** `validation.mdc`, `security.mdc`, `../../patterns/input-sanitization.mdc`
