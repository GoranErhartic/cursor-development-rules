## Rate Limiting

```typescript
// src/shared/middleware/rate-limit.ts

import rateLimit from "express-rate-limit";
import RedisStore from "rate-limit-redis";
import { Redis } from "ioredis";

const redisClient = new Redis({
  host: process.env.REDIS_HOST,
  port: parseInt(process.env.REDIS_PORT ?? "6379", 10),
});

// General API rate limit
export const apiRateLimit = rateLimit({
  store: new RedisStore({
    sendCommand: (...args: string[]) => redisClient.call(...args),
  }),
  windowMs: 60 * 1000, // 1 minute
  max: 100, // 100 requests per minute
  standardHeaders: true, // X-RateLimit-* headers
  legacyHeaders: false,
  message: {
    type: "https://api.example.com/errors/rate-limit",
    title: "Too Many Requests",
    status: 429,
    detail: "Rate limit exceeded. Please try again later.",
  },
  keyGenerator: (req) => {
    // Use user ID if authenticated, otherwise IP
    return (req as any).user?.id ?? req.ip;
  },
});

// Stricter limit for authentication endpoints
export const authRateLimit = rateLimit({
  store: new RedisStore({
    sendCommand: (...args: string[]) => redisClient.call(...args),
    prefix: "rl:auth:",
  }),
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 5, // 5 attempts per 15 minutes
  message: {
    type: "https://api.example.com/errors/rate-limit",
    title: "Too Many Requests",
    status: 429,
    detail: "Too many login attempts. Please try again later.",
  },
  skipSuccessfulRequests: true, // Only count failed attempts
});

// Slow down repeated requests
import slowDown from "express-slow-down";

export const speedLimiter = slowDown({
  windowMs: 60 * 1000,
  delayAfter: 50, // Allow 50 requests per minute
  delayMs: (hits) => hits * 100, // Add 100ms * hits delay
  maxDelayMs: 5000, // Max 5 second delay
});

// Usage
app.use("/api", apiRateLimit);
app.use("/auth/login", authRateLimit);
app.use("/api", speedLimiter);
```

### Fastify Rate Limiting

```typescript
import fastifyRateLimit from "@fastify/rate-limit";

await fastify.register(fastifyRateLimit, {
  max: 100,
  timeWindow: "1 minute",
  redis: redisClient,
  keyGenerator: (request) => {
    return request.user?.id ?? request.ip;
  },
  errorResponseBuilder: (request, context) => ({
    statusCode: 429,
    error: "Too Many Requests",
    message: `Rate limit exceeded. ${context.after}`,
  }),
});
```

## CSRF Protection

```typescript
// src/shared/middleware/csrf.ts

import csrf from "csurf";
import type { Express, Request, Response, NextFunction } from "express";

// For session-based authentication
export function configureCsrf(app: Express): void {
  const csrfProtection = csrf({
    cookie: {
      httpOnly: true,
      secure: process.env.NODE_ENV === "production",
      sameSite: "strict",
    },
  });

  // Apply to state-changing routes
  app.use("/api", csrfProtection);

  // Provide token to frontend
  app.get("/api/csrf-token", (req: Request, res: Response) => {
    res.json({ csrfToken: req.csrfToken() });
  });
}

// For JWT with cookies, use double-submit pattern
export function csrfDoubleSubmit(
  req: Request,
  res: Response,
  next: NextFunction
): void {
  if (["POST", "PUT", "PATCH", "DELETE"].includes(req.method)) {
    const cookieToken = req.cookies["csrf-token"];
    const headerToken = req.headers["x-csrf-token"];

    if (!cookieToken || !headerToken || cookieToken !== headerToken) {
      res.status(403).json({
        type: "https://api.example.com/errors/csrf",
        title: "CSRF Error",
        status: 403,
        detail: "Invalid CSRF token",
      });
      return;
    }
  }
  next();
}
```

## Request Size Limits

```typescript
// src/app.ts

import express from "express";

const app = express();

// Limit JSON body size
app.use(express.json({ limit: "100kb" }));

// Limit URL-encoded body
app.use(express.urlencoded({ extended: true, limit: "100kb" }));

// Limit raw body for specific routes
app.use("/webhooks", express.raw({ type: "*/*", limit: "1mb" }));

// File upload limits (with multer)
import multer from "multer";

const upload = multer({
  limits: {
    fileSize: 5 * 1024 * 1024, // 5MB
    files: 5, // Max 5 files
  },
});
```

## Input Validation

```typescript
// Always validate and sanitize input
import { z } from "zod";

const userSchema = z.object({
  email: z.string().email().max(255),
  name: z.string().min(1).max(100).trim(),
  age: z.number().int().min(0).max(150),
});

// Validate content type
function requireJsonContentType(
  req: Request,
  res: Response,
  next: NextFunction
): void {
  if (
    ["POST", "PUT", "PATCH"].includes(req.method) &&
    !req.is("application/json")
  ) {
    res.status(415).json({
      error: "Content-Type must be application/json",
    });
    return;
  }
  next();
}
```

## SQL Injection Prevention

```typescript
// ALWAYS use parameterized queries

// Prisma - Safe by default
const user = await prisma.user.findUnique({
  where: { email: userInput },
});

// Drizzle - Safe by default
const user = await db.query.users.findFirst({
  where: eq(users.email, userInput),
});

// Raw SQL - Use parameterized queries
const users = await prisma.$queryRaw`
  SELECT * FROM users WHERE email = ${userInput}
`;

// NEVER do this
const users = await prisma.$queryRawUnsafe(
  `SELECT * FROM users WHERE email = '${userInput}'` // SQL INJECTION!
);
```

## Secrets Management

```typescript
// src/shared/config/secrets.ts

// NEVER commit secrets to code
// Use environment variables

const requiredSecrets = [
  "JWT_SECRET",
  "DATABASE_URL",
  "REDIS_URL",
  "SESSION_SECRET",
] as const;

export function validateSecrets(): void {
  const missing = requiredSecrets.filter((key) => !process.env[key]);

  if (missing.length > 0) {
    throw new Error(`Missing required secrets: ${missing.join(", ")}`);
  }
}

// Access secrets safely
export const secrets = {
  get jwtSecret(): string {
    return process.env.JWT_SECRET!;
  },
  get databaseUrl(): string {
    return process.env.DATABASE_URL!;
  },
} as const;

// For production, use secret managers
// - AWS Secrets Manager
// - HashiCorp Vault
// - Kubernetes Secrets
// - Doppler
```

## HTTP Parameter Pollution Prevention

```typescript
// src/shared/middleware/hpp.ts

import hpp from "hpp";

// Prevent HTTP Parameter Pollution
app.use(hpp({
  whitelist: ["sort", "filter"], // Allow duplicate params for these
}));

// This prevents attacks like:
// /api/users?role=admin&role=user
// Without hpp, req.query.role might be ['admin', 'user']
```

## Security Logging

```typescript
// Log security-relevant events
import { logger } from "@/shared/logger";

// Failed authentication
logger.warn({
  event: "auth:failed",
  email: email, // Don't log password!
  ip: req.ip,
  userAgent: req.headers["user-agent"],
});

// Successful authentication
logger.info({
  event: "auth:success",
  userId: user.id,
  ip: req.ip,
});

// Authorization failure
logger.warn({
  event: "authz:denied",
  userId: user.id,
  resource: req.path,
  requiredRole: "admin",
  actualRole: user.role,
});

// Rate limit exceeded
logger.warn({
  event: "rate_limit:exceeded",
  ip: req.ip,
  path: req.path,
  userId: (req as any).user?.id,
});
```

