## TypeORM (NestJS)

### Entity Definition

```typescript
// src/modules/users/entities/user.entity.ts

import {
  Entity,
  PrimaryGeneratedColumn,
  Column,
  CreateDateColumn,
  UpdateDateColumn,
  OneToMany,
  Index,
} from "typeorm";
import { Post } from "@/modules/posts/entities/post.entity";

export enum Role {
  USER = "USER",
  ADMIN = "ADMIN",
}

@Entity("users")
export class User {
  @PrimaryGeneratedColumn("uuid")
  id: string;

  @Column({ unique: true })
  @Index()
  email: string;

  @Column()
  name: string;

  @Column()
  password: string;

  @Column({ type: "enum", enum: Role, default: Role.USER })
  role: Role;

  @OneToMany(() => Post, (post) => post.author)
  posts: Post[];

  @CreateDateColumn()
  createdAt: Date;

  @UpdateDateColumn()
  updatedAt: Date;
}
```

### TypeORM Repository

```typescript
// src/modules/users/user.repository.ts

import { Injectable } from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { Repository, Like, ILike } from "typeorm";
import { User } from "./entities/user.entity";

@Injectable()
export class UserRepository {
  constructor(
    @InjectRepository(User)
    private readonly repository: Repository<User>
  ) {}

  async findById(id: string): Promise<User | null> {
    return this.repository.findOne({ where: { id } });
  }

  async findByEmail(email: string): Promise<User | null> {
    return this.repository.findOne({ where: { email } });
  }

  async findAll(params: {
    page: number;
    limit: number;
    search?: string;
  }): Promise<User[]> {
    const { page, limit, search } = params;

    return this.repository.find({
      where: search
        ? [
            { name: ILike(`%${search}%`) },
            { email: ILike(`%${search}%`) },
          ]
        : undefined,
      skip: (page - 1) * limit,
      take: limit,
      order: { createdAt: "DESC" },
    });
  }

  async save(user: Partial<User>): Promise<User> {
    return this.repository.save(user);
  }

  async delete(id: string): Promise<void> {
    await this.repository.delete(id);
  }
}
```

## Query Optimization

### Select Only Needed Fields

```typescript
// Prisma
const users = await prisma.user.findMany({
  select: {
    id: true,
    name: true,
    email: true,
    // Don't select password
  },
});

// Drizzle
const users = await db
  .select({
    id: users.id,
    name: users.name,
    email: users.email,
  })
  .from(users);
```

### Avoid N+1 Queries

```typescript
// BAD - N+1 queries
const users = await prisma.user.findMany();
for (const user of users) {
  const posts = await prisma.post.findMany({
    where: { authorId: user.id },
  });
}

// GOOD - Include relations
const users = await prisma.user.findMany({
  include: {
    posts: true,
  },
});

// GOOD - Drizzle with relations
const users = await db.query.users.findMany({
  with: {
    posts: true,
  },
});
```

### Pagination

```typescript
// Cursor-based pagination (better for large datasets)
async function findUsersCursor(cursor?: string, limit = 20) {
  return prisma.user.findMany({
    take: limit + 1, // Fetch one extra to check if there's more
    cursor: cursor ? { id: cursor } : undefined,
    skip: cursor ? 1 : 0, // Skip the cursor itself
    orderBy: { createdAt: "desc" },
  });
}

// Offset pagination
async function findUsersOffset(page: number, limit: number) {
  const [users, total] = await Promise.all([
    prisma.user.findMany({
      skip: (page - 1) * limit,
      take: limit,
      orderBy: { createdAt: "desc" },
    }),
    prisma.user.count(),
  ]);

  return {
    data: users,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
  };
}
```

## Soft Deletes

```typescript
// Prisma schema
model User {
  id        String    @id @default(uuid())
  deletedAt DateTime?
  // ...
}

// Middleware for soft deletes
prisma.$use(async (params, next) => {
  if (params.model === "User") {
    if (params.action === "delete") {
      params.action = "update";
      params.args.data = { deletedAt: new Date() };
    }
    if (params.action === "findMany" || params.action === "findFirst") {
      params.args.where = {
        ...params.args.where,
        deletedAt: null,
      };
    }
  }
  return next(params);
});
```

## Conventions

- Use repository pattern to abstract database access
- Always use parameterized queries (handled by ORMs)
- Use transactions for operations that modify multiple tables
- Select only needed fields to reduce data transfer
- Use eager loading to avoid N+1 queries
- Implement soft deletes for audit trails
- Use migrations for schema changes
- Index frequently queried columns

## Anti-Patterns

- ❌ Raw SQL queries with string interpolation
- ❌ N+1 query problems
- ❌ Fetching entire tables without pagination
- ❌ Business logic in repositories (keep in services)
- ❌ Skipping migrations in production
- ❌ Exposing database entities directly in API responses
- ❌ Not using transactions for multi-step operations
- ❌ Hardcoding connection strings

**See also:** `testing.mdc`, `error-handling.mdc`
