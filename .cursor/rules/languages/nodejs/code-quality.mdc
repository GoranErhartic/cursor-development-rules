## Naming Conventions

| Element | Convention | Example |
|---------|------------|---------|
| Variables | camelCase | `userData`, `isActive` |
| Functions | camelCase | `getUserById`, `validateEmail` |
| Classes | PascalCase | `UserService`, `OrderRepository` |
| Interfaces | PascalCase | `UserDto`, `CreateOrderRequest` |
| Types | PascalCase | `UserId`, `OrderStatus` |
| Constants | UPPER_SNAKE_CASE | `MAX_RETRIES`, `DEFAULT_TIMEOUT` |
| Enums | PascalCase | `OrderStatus.Pending` |
| Files | kebab-case | `user-service.ts`, `order-repository.ts` |
| Folders | kebab-case | `user-management/`, `order-processing/` |

## Type Best Practices

### Prefer Type Inference

```typescript
// GOOD - Let TypeScript infer when obvious
const users = []; // Inferred as never[] - be explicit here
const count = 0; // Inferred as number - OK

// GOOD - Be explicit for function returns and complex types
function getUser(id: string): User | undefined {
  return users.find((u) => u.id === id);
}

// BAD - Redundant type annotation
const name: string = "John"; // string is obvious
```

### Use Branded Types for IDs

```typescript
// GOOD - Prevents mixing different ID types
declare const UserIdBrand: unique symbol;
declare const OrderIdBrand: unique symbol;

type UserId = string & { readonly [UserIdBrand]: typeof UserIdBrand };
type OrderId = string & { readonly [OrderIdBrand]: typeof OrderIdBrand };

function createUserId(id: string): UserId {
  return id as UserId;
}

function getUser(id: UserId): User {
  // TypeScript prevents passing OrderId here
}

// BAD - Plain strings can be mixed up
function getUser(id: string): User {} // Could pass orderId by mistake
```

### Use Discriminated Unions

```typescript
// GOOD - Exhaustive pattern matching
type Result<T> =
  | { success: true; data: T }
  | { success: false; error: Error };

function handleResult<T>(result: Result<T>): T | null {
  if (result.success) {
    return result.data; // TypeScript knows data exists
  }
  console.error(result.error); // TypeScript knows error exists
  return null;
}
```

### Avoid `any`, Use `unknown`

```typescript
// GOOD - Type-safe unknown handling
function parseJson(json: string): unknown {
  return JSON.parse(json);
}

const data = parseJson('{"name": "John"}');
if (isUser(data)) {
  console.log(data.name); // Safe after type guard
}

// BAD - Loses all type safety
function parseJson(json: string): any {
  return JSON.parse(json);
}
```

## Function Patterns

### Use Readonly Parameters

```typescript
// GOOD - Prevents accidental mutation
function processUsers(users: readonly User[]): void {
  // users.push() would be a compile error
  users.forEach((user) => console.log(user.name));
}

// GOOD - Deep readonly for objects
type DeepReadonly<T> = {
  readonly [P in keyof T]: T[P] extends object ? DeepReadonly<T[P]> : T[P];
};

function processOrder(order: DeepReadonly<Order>): void {
  // Cannot mutate any nested property
}
```

### Use Function Overloads Sparingly

```typescript
// GOOD - Single function with union types when possible
function find<T>(items: T[], predicate: (item: T) => boolean): T | undefined;
function find<T>(items: T[], id: string): T | undefined;
function find<T>(
  items: T[],
  predicateOrId: ((item: T) => boolean) | string
): T | undefined {
  if (typeof predicateOrId === "string") {
    return items.find((item) => (item as { id: string }).id === predicateOrId);
  }
  return items.find(predicateOrId);
}
```

## Error Handling

### Use Custom Error Classes

```typescript
// GOOD - Structured error handling
class AppError extends Error {
  constructor(
    message: string,
    public readonly code: string,
    public readonly statusCode: number = 500,
    public readonly isOperational: boolean = true
  ) {
    super(message);
    this.name = this.constructor.name;
    Error.captureStackTrace(this, this.constructor);
  }
}

class NotFoundError extends AppError {
  constructor(resource: string, id: string) {
    super(`${resource} with id ${id} not found`, "NOT_FOUND", 404);
  }
}

class ValidationError extends AppError {
  constructor(
    message: string,
    public readonly errors: Record<string, string[]>
  ) {
    super(message, "VALIDATION_ERROR", 400);
  }
}
```

