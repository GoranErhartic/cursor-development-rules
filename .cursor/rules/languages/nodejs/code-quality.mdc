## Import Organization

```typescript
// 1. Node.js built-ins
import { readFile } from "node:fs/promises";
import { join } from "node:path";

// 2. External packages
import express from "express";
import { z } from "zod";

// 3. Internal modules (absolute paths)
import { UserService } from "@/modules/users/user.service";
import { logger } from "@/shared/logger";

// 4. Relative imports
import { UserDto } from "./user.dto";
import type { CreateUserRequest } from "./user.types";
```

## Async/Await Best Practices

```typescript
// GOOD - Always handle promise rejections
async function fetchUser(id: string): Promise<User> {
  try {
    const response = await fetch(`/api/users/${id}`);
    if (!response.ok) {
      throw new NotFoundError("User", id);
    }
    return (await response.json()) as User;
  } catch (error) {
    if (error instanceof AppError) throw error;
    throw new AppError("Failed to fetch user", "FETCH_ERROR");
  }
}

// GOOD - Parallel execution when independent
async function getUserWithOrders(userId: string): Promise<UserWithOrders> {
  const [user, orders] = await Promise.all([
    userService.findById(userId),
    orderService.findByUserId(userId),
  ]);
  return { ...user, orders };
}

// BAD - Sequential when could be parallel
async function getUserWithOrders(userId: string): Promise<UserWithOrders> {
  const user = await userService.findById(userId);
  const orders = await orderService.findByUserId(userId); // Waits unnecessarily
  return { ...user, orders };
}
```

## Conventions

- ALWAYS enable TypeScript strict mode
- Use ESLint with typescript-eslint for static analysis
- Use Prettier for consistent formatting
- Prefer `unknown` over `any`
- Use branded types for IDs to prevent mixing
- Use discriminated unions for type-safe pattern matching
- Keep files focused and under 300 lines
- Use barrel exports (`index.ts`) for public module APIs
- Prefix Node.js built-ins with `node:` (e.g., `node:fs`)

## Anti-Patterns

- ❌ Using `any` type
- ❌ Disabling TypeScript strict checks
- ❌ Ignoring ESLint errors with `eslint-disable`
- ❌ Using `!` non-null assertion without validation
- ❌ Mixing business logic with infrastructure code
- ❌ Creating circular dependencies between modules
- ❌ Using default exports (prefer named exports)
- ❌ Leaving console.log statements in production code

