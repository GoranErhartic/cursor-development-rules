# Resilience Patterns

## Overview

Resilience patterns protect your application from cascading failures when external services fail.

| Pattern | Purpose | Use When |
|---------|---------|----------|
| **Retry** | Recover from transient failures | Network glitches, timeouts |
| **Circuit Breaker** | Fail fast, prevent cascade | Service is down |
| **Timeout** | Bound wait time | Slow responses |
| **Bulkhead** | Isolate failures | Limit concurrent calls |
| **Fallback** | Provide alternative | Graceful degradation |

## Cockatiel (Recommended)

Cockatiel provides TypeScript-first resilience primitives.

### Installation

```bash
pnpm add cockatiel
```

### Retry Policy

```typescript
// src/shared/resilience/policies.ts

import {
  retry,
  handleAll,
  handleType,
  ExponentialBackoff,
  ConstantBackoff,
} from "cockatiel";
import { logger } from "@/shared/logger";

// Retry with exponential backoff
export const retryPolicy = retry(handleAll, {
  maxAttempts: 3,
  backoff: new ExponentialBackoff({
    initialDelay: 100,
    maxDelay: 5000,
    exponent: 2,
  }),
});

// Retry only specific errors
class TransientError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "TransientError";
  }
}

export const transientRetryPolicy = retry(handleType(TransientError), {
  maxAttempts: 5,
  backoff: new ExponentialBackoff(),
});

// With logging
retryPolicy.onRetry((event) => {
  logger.warn(
    {
      attempt: event.attempt,
      delay: event.delay,
      error: event.reason,
    },
    "Retrying operation"
  );
});

retryPolicy.onGiveUp((event) => {
  logger.error(
    {
      attempts: event.attempt,
      error: event.reason,
    },
    "Retry attempts exhausted"
  );
});
```

### Circuit Breaker

```typescript
// src/shared/resilience/policies.ts

import {
  circuitBreaker,
  ConsecutiveBreaker,
  SamplingBreaker,
  CircuitState,
} from "cockatiel";
import { logger } from "@/shared/logger";

// Open after 5 consecutive failures
export const consecutiveCircuitBreaker = circuitBreaker(handleAll, {
  halfOpenAfter: 10000, // 10 seconds
  breaker: new ConsecutiveBreaker(5),
});

// Open based on failure rate (50% of 10 calls)
export const samplingCircuitBreaker = circuitBreaker(handleAll, {
  halfOpenAfter: 30000, // 30 seconds
  breaker: new SamplingBreaker({
    threshold: 0.5, // 50% failure rate
    duration: 30000, // Over 30 seconds
    minimumRps: 5, // Minimum requests before triggering
  }),
});

// Monitor state changes
consecutiveCircuitBreaker.onStateChange((state) => {
  logger.info({ state: CircuitState[state] }, "Circuit breaker state changed");
});

consecutiveCircuitBreaker.onBreak((event) => {
  logger.warn(
    { duration: event.duration },
    "Circuit breaker opened"
  );
});

consecutiveCircuitBreaker.onReset(() => {
  logger.info("Circuit breaker reset");
});
```

### Timeout Policy

```typescript
// src/shared/resilience/policies.ts

import { timeout, TimeoutStrategy } from "cockatiel";

// Cancel after timeout
export const timeoutPolicy = timeout(5000, TimeoutStrategy.Aggressive);

// Cooperative timeout (let operation complete but don't wait)
export const cooperativeTimeout = timeout(5000, TimeoutStrategy.Cooperative);

timeoutPolicy.onTimeout(() => {
  logger.warn("Operation timed out");
});
```

### Bulkhead (Concurrency Limiter)

```typescript
// src/shared/resilience/policies.ts

import { bulkhead } from "cockatiel";

// Limit concurrent operations
export const bulkheadPolicy = bulkhead(10, 100); // 10 concurrent, 100 queue

bulkheadPolicy.onReject(() => {
  logger.warn("Request rejected by bulkhead - too many concurrent requests");
});

// Usage
const result = await bulkheadPolicy.execute(() => expensiveOperation());
```

### Combined Policies

```typescript
// src/shared/resilience/policies.ts

import { wrap } from "cockatiel";

// Combine: timeout → retry → circuit breaker
export const resilientPolicy = wrap(
  timeoutPolicy,
  retryPolicy,
  consecutiveCircuitBreaker
);

// Usage
const result = await resilientPolicy.execute(() =>
  externalService.fetchData()
);
```

## HTTP Client with Resilience

```typescript
// src/shared/http/resilient-client.ts

import { wrap, retry, circuitBreaker, timeout, handleAll, ExponentialBackoff, ConsecutiveBreaker } from "cockatiel";
import { logger } from "@/shared/logger";

const policy = wrap(
  timeout(10000),
  retry(handleAll, {
    maxAttempts: 3,
    backoff: new ExponentialBackoff({ initialDelay: 100 }),
  }),
  circuitBreaker(handleAll, {
    halfOpenAfter: 30000,
    breaker: new ConsecutiveBreaker(5),
  })
);

export async function resilientFetch<T>(
  url: string,
  options?: RequestInit
): Promise<T> {
  return policy.execute(async ({ signal }) => {
    const response = await fetch(url, {
      ...options,
      signal, // Timeout integration
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${response.statusText}`);
    }

    return response.json() as Promise<T>;
  });
}

// Service-specific client
export class UserApiClient {
  private readonly baseUrl: string;
  private readonly policy: typeof policy;

  constructor(baseUrl: string) {
    this.baseUrl = baseUrl;
    this.policy = wrap(
      timeout(5000),
      retry(handleAll, { maxAttempts: 2 }),
      circuitBreaker(handleAll, {
        halfOpenAfter: 10000,
        breaker: new ConsecutiveBreaker(3),
      })
    );
  }

  async getUser(id: string): Promise<User> {
    return this.policy.execute(async ({ signal }) => {
      const response = await fetch(`${this.baseUrl}/users/${id}`, { signal });

      if (!response.ok) {
        if (response.status === 404) {
          throw new UserNotFoundError(id);
        }
        throw new Error(`Failed to fetch user: ${response.status}`);
      }

      return response.json();
    });
  }
}
```

## Fallback Pattern

```typescript
// src/shared/resilience/fallback.ts

import { Policy } from "cockatiel";

// Execute with fallback
async function fetchWithFallback<T>(
  primary: () => Promise<T>,
  fallback: () => Promise<T>
): Promise<T> {
  try {
    return await resilientPolicy.execute(primary);
  } catch (error) {
    logger.warn({ err: error }, "Primary failed, using fallback");
    return fallback();
  }
}

// Cached fallback
const userCache = new Map<string, User>();

async function getUserWithCacheFallback(id: string): Promise<User | null> {
  try {
    const user = await resilientPolicy.execute(() =>
      userApiClient.getUser(id)
    );
    userCache.set(id, user);
    return user;
  } catch (error) {
    logger.warn({ err: error, userId: id }, "Using cached user data");
    return userCache.get(id) ?? null;
  }
}
```

## Request Deduplication

```typescript
// src/shared/resilience/dedup.ts

const inflightRequests = new Map<string, Promise<unknown>>();

export async function deduplicatedFetch<T>(
  key: string,
  fetcher: () => Promise<T>
): Promise<T> {
  const existing = inflightRequests.get(key);
  if (existing) {
    return existing as Promise<T>;
  }

  const promise = fetcher().finally(() => {
    inflightRequests.delete(key);
  });

  inflightRequests.set(key, promise);
  return promise;
}

// Usage - Multiple calls to same user won't trigger multiple requests
const [user1, user2, user3] = await Promise.all([
  deduplicatedFetch(`user:${id}`, () => userClient.getUser(id)),
  deduplicatedFetch(`user:${id}`, () => userClient.getUser(id)),
  deduplicatedFetch(`user:${id}`, () => userClient.getUser(id)),
]);
```

## Rate Limiting

```typescript
// src/shared/resilience/rate-limiter.ts

import pThrottle from "p-throttle";

// Limit to 10 calls per second
const throttle = pThrottle({
  limit: 10,
  interval: 1000,
});

export const throttledFetch = throttle(async (url: string) => {
  const response = await fetch(url);
  return response.json();
});

// Token bucket for API rate limits
class TokenBucket {
  private tokens: number;
  private lastRefill: number;

  constructor(
    private readonly capacity: number,
    private readonly refillRate: number // tokens per second
  ) {
    this.tokens = capacity;
    this.lastRefill = Date.now();
  }

  async acquire(): Promise<void> {
    this.refill();

    if (this.tokens < 1) {
      const waitTime = (1 / this.refillRate) * 1000;
      await new Promise((resolve) => setTimeout(resolve, waitTime));
      return this.acquire();
    }

    this.tokens -= 1;
  }

  private refill(): void {
    const now = Date.now();
    const elapsed = (now - this.lastRefill) / 1000;
    this.tokens = Math.min(this.capacity, this.tokens + elapsed * this.refillRate);
    this.lastRefill = now;
  }
}

// Usage
const rateLimiter = new TokenBucket(100, 10); // 100 capacity, 10/sec refill

async function rateLimitedRequest<T>(fetcher: () => Promise<T>): Promise<T> {
  await rateLimiter.acquire();
  return fetcher();
}
```

## Health Checks

```typescript
// src/shared/health/index.ts

interface HealthCheck {
  name: string;
  check: () => Promise<boolean>;
}

const healthChecks: HealthCheck[] = [
  {
    name: "database",
    check: async () => {
      try {
        await prisma.$queryRaw`SELECT 1`;
        return true;
      } catch {
        return false;
      }
    },
  },
  {
    name: "redis",
    check: async () => {
      try {
        await redis.ping();
        return true;
      } catch {
        return false;
      }
    },
  },
  {
    name: "external-api",
    check: async () => {
      try {
        const response = await fetch(`${EXTERNAL_API}/health`, {
          signal: AbortSignal.timeout(5000),
        });
        return response.ok;
      } catch {
        return false;
      }
    },
  },
];

export async function checkHealth(): Promise<{
  healthy: boolean;
  checks: Record<string, boolean>;
}> {
  const results = await Promise.all(
    healthChecks.map(async ({ name, check }) => ({
      name,
      healthy: await check().catch(() => false),
    }))
  );

  const checks = Object.fromEntries(
    results.map(({ name, healthy }) => [name, healthy])
  );

  return {
    healthy: results.every(({ healthy }) => healthy),
    checks,
  };
}

// Express endpoint
router.get("/health", async (req, res) => {
  const health = await checkHealth();
  res.status(health.healthy ? 200 : 503).json(health);
});

router.get("/ready", async (req, res) => {
  const health = await checkHealth();
  res.status(health.healthy ? 200 : 503).json(health);
});
```

## Graceful Shutdown

```typescript
// src/shared/shutdown.ts

import { logger } from "@/shared/logger";

const shutdownCallbacks: (() => Promise<void>)[] = [];

export function onShutdown(callback: () => Promise<void>): void {
  shutdownCallbacks.push(callback);
}

async function shutdown(signal: string): Promise<void> {
  logger.info({ signal }, "Shutdown signal received");

  // Stop accepting new requests
  server.close();

  // Run cleanup callbacks
  for (const callback of shutdownCallbacks) {
    try {
      await callback();
    } catch (error) {
      logger.error({ err: error }, "Error during shutdown");
    }
  }

  logger.info("Graceful shutdown complete");
  process.exit(0);
}

process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));

// Register cleanup handlers
onShutdown(async () => {
  await prisma.$disconnect();
});

onShutdown(async () => {
  await redis.quit();
});
```

## Conventions

- Apply retry for transient failures (network, 5xx errors)
- Use circuit breakers for external service calls
- Always set timeouts on HTTP calls
- Combine policies: timeout → retry → circuit breaker
- Log all resilience events for monitoring
- Implement health checks for all dependencies
- Use fallbacks for non-critical operations
- Implement graceful shutdown

## Anti-Patterns

- ❌ Retrying non-idempotent operations without consideration
- ❌ Infinite retries without backoff
- ❌ No timeout on external calls
- ❌ Circuit breaker thresholds too sensitive or too lenient
- ❌ Ignoring circuit breaker state in monitoring
- ❌ Missing health checks
- ❌ Hard shutdown without cleanup
- ❌ Retrying 4xx client errors (only retry transient failures)

**See also:** `http-clients.mdc`, `logging.mdc`, `error-handling.mdc`
