## Correlation IDs

### Middleware Implementation

```typescript
// src/shared/middleware/correlation-id.ts

import { AsyncLocalStorage } from "node:async_hooks";
import { randomUUID } from "node:crypto";
import type { Request, Response, NextFunction } from "express";

interface RequestContext {
  correlationId: string;
  userId?: string;
}

export const requestContext = new AsyncLocalStorage<RequestContext>();

export function correlationIdMiddleware(
  req: Request,
  res: Response,
  next: NextFunction
): void {
  const correlationId =
    (req.headers["x-correlation-id"] as string) ?? randomUUID();

  // Set response header
  res.setHeader("X-Correlation-Id", correlationId);

  // Store in AsyncLocalStorage
  const context: RequestContext = {
    correlationId,
    userId: (req as any).user?.id,
  };

  requestContext.run(context, () => next());
}

// Helper to get correlation ID anywhere
export function getCorrelationId(): string {
  return requestContext.getStore()?.correlationId ?? "unknown";
}

export function getUserId(): string | undefined {
  return requestContext.getStore()?.userId;
}
```

### Logger with Context

```typescript
// src/shared/logger/context-logger.ts

import { logger as baseLogger } from "./index";
import { getCorrelationId, getUserId } from "@/shared/middleware/correlation-id";

export function createContextLogger() {
  return baseLogger.child({
    get correlationId() {
      return getCorrelationId();
    },
    get userId() {
      return getUserId();
    },
  });
}

// Usage
const logger = createContextLogger();
logger.info("Processing order"); // Includes correlationId automatically
```

## Structured Logging Best Practices

```typescript
// CORRECT - Structured with named properties
logger.info({ userId, orderId, amount }, "User created order");

// WRONG - String interpolation (loses structure)
logger.info(`User ${userId} created order ${orderId} for ${amount}`);

// CORRECT - Include relevant context
logger.error({ err, orderId }, "Failed to process payment");

// WRONG - Missing error object
logger.error(`Failed to process payment: ${err.message}`);

// CORRECT - Use child loggers for context
const orderLogger = logger.child({ orderId, customerId });
orderLogger.info("Order created");
orderLogger.info("Payment processed");
orderLogger.info("Order shipped");

// CORRECT - Consistent property names
logger.info({ userId: user.id, action: "login" }, "User logged in");
logger.info({ userId: user.id, action: "logout" }, "User logged out");
```

## Log Levels

| Level | Use Case | Example |
|-------|----------|---------|
| `fatal` | Application crash, unrecoverable | Uncaught exception |
| `error` | Exceptions, failures requiring attention | Database connection failed |
| `warn` | Unexpected but recoverable situations | Deprecated API usage |
| `info` | Normal operations, request/response | User created, order placed |
| `debug` | Development diagnostics | Function entry/exit |
| `trace` | Detailed debugging (rarely in production) | Loop iterations |

```typescript
// Set log level per environment
const logLevel = {
  production: "info",
  staging: "debug",
  development: "debug",
  test: "silent",
}[process.env.NODE_ENV ?? "development"];
```

## Winston (Alternative)

```typescript
// src/shared/logger/winston.ts

import winston from "winston";

const { combine, timestamp, json, errors, printf, colorize } = winston.format;

// Development format
const devFormat = combine(
  colorize(),
  timestamp(),
  errors({ stack: true }),
  printf(({ level, message, timestamp, stack, ...meta }) => {
    const metaStr = Object.keys(meta).length ? JSON.stringify(meta) : "";
    return `${timestamp} ${level}: ${message} ${metaStr}${stack ? `\n${stack}` : ""}`;
  })
);

// Production format
const prodFormat = combine(
  timestamp(),
  errors({ stack: true }),
  json()
);

export const logger = winston.createLogger({
  level: process.env.LOG_LEVEL ?? "info",
  format: process.env.NODE_ENV === "production" ? prodFormat : devFormat,
  defaultMeta: {
    service: process.env.SERVICE_NAME ?? "api",
  },
  transports: [
    new winston.transports.Console(),
  ],
});

// Add file transport in production
if (process.env.NODE_ENV === "production") {
  logger.add(
    new winston.transports.File({
      filename: "logs/error.log",
      level: "error",
    })
  );
  logger.add(
    new winston.transports.File({
      filename: "logs/combined.log",
    })
  );
}
```

## Sensitive Data Handling

```typescript
// NEVER log passwords, tokens, or PII
logger.info({ email: user.email, password: user.password }); // ❌ BAD

// Redact sensitive fields
const safeUser = {
  id: user.id,
  email: user.email,
  // Don't include password, ssn, etc.
};
logger.info({ user: safeUser }, "User created"); // ✅ GOOD

// Use Pino redaction
const logger = pino({
  redact: {
    paths: [
      "password",
      "*.password",
      "token",
      "*.token",
      "authorization",
      "req.headers.authorization",
      "req.headers.cookie",
    ],
    censor: "[REDACTED]",
  },
});

// Mask partial data
function maskEmail(email: string): string {
  const [local, domain] = email.split("@");
  return `${local[0]}***@${domain}`;
}

logger.info({ email: maskEmail(user.email) }, "Sending verification email");
```

## Error Logging

```typescript
// Always include the error object
try {
  await processOrder(order);
} catch (error) {
  // CORRECT - Error as first property (Pino convention)
  logger.error({ err: error, orderId: order.id }, "Order processing failed");
  
  // For Winston
  logger.error("Order processing failed", { error, orderId: order.id });
}

// Log and rethrow
try {
  await externalService.call();
} catch (error) {
  logger.error({ err: error }, "External service call failed");
  throw error; // Re-throw for error handler
}
```

## Request/Response Logging

```typescript
// Log meaningful request data
const requestLogger = pinoHttp({
  logger,
  serializers: {
    req: (req) => ({
      id: req.id,
      method: req.method,
      url: req.url,
      query: req.query,
      // Don't log body by default (might contain sensitive data)
    }),
    res: (res) => ({
      statusCode: res.statusCode,
    }),
  },
});

// Log specific body fields when needed
logger.info(
  {
    action: "createUser",
    email: req.body.email,
    name: req.body.name,
    // Don't log password
  },
  "Creating user"
);
```

## Performance Logging

```typescript
// Log operation duration
async function measureOperation<T>(
  name: string,
  operation: () => Promise<T>
): Promise<T> {
  const start = performance.now();
  
  try {
    const result = await operation();
    const duration = performance.now() - start;
    
    logger.info(
      { operation: name, durationMs: duration.toFixed(2) },
      "Operation completed"
    );
    
    return result;
  } catch (error) {
    const duration = performance.now() - start;
    
    logger.error(
      { err: error, operation: name, durationMs: duration.toFixed(2) },
      "Operation failed"
    );
    
    throw error;
  }
}

// Usage
const users = await measureOperation("findAllUsers", () =>
  userRepository.findAll({ page: 1, limit: 20 })
);
```

## Conventions

- ALWAYS use structured logging with named properties
- ALWAYS include correlation ID in logs
- NEVER log sensitive data (passwords, tokens, PII)
- Use appropriate log levels
- Include error object as `err` property (Pino convention)
- Use child loggers for request-scoped context
- Configure log level overrides to reduce noise
- Use JSON format in production for log aggregation

## Anti-Patterns

- ❌ String interpolation instead of structured logging
- ❌ Logging sensitive data (passwords, tokens, PII)
- ❌ Missing correlation IDs
- ❌ console.log in production code
- ❌ Inconsistent property names across logs
- ❌ Logging too much (verbose in production)
- ❌ Logging too little (missing context)
- ❌ Not logging errors properly (missing stack traces)

**See also:** `error-handling.mdc`, `security.mdc`
