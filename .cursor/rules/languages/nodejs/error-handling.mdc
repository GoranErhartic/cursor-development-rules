# Error Handling

## Result Pattern

Use the Result pattern for operations that can fail predictably. Exceptions are for unexpected errors only.

### Result Type Definition

```typescript
// src/shared/result.ts

export type Result<T, E = AppError> =
  | { success: true; data: T }
  | { success: false; error: E };

export const Result = {
  ok<T>(data: T): Result<T, never> {
    return { success: true, data };
  },

  fail<E>(error: E): Result<never, E> {
    return { success: false, error };
  },

  isOk<T, E>(result: Result<T, E>): result is { success: true; data: T } {
    return result.success;
  },

  isFail<T, E>(result: Result<T, E>): result is { success: false; error: E } {
    return !result.success;
  },

  map<T, U, E>(result: Result<T, E>, fn: (data: T) => U): Result<U, E> {
    if (result.success) {
      return Result.ok(fn(result.data));
    }
    return result;
  },

  flatMap<T, U, E>(
    result: Result<T, E>,
    fn: (data: T) => Result<U, E>
  ): Result<U, E> {
    if (result.success) {
      return fn(result.data);
    }
    return result;
  },
};
```

### Domain Errors

```typescript
// src/shared/errors/app-error.ts

export interface AppError {
  code: string;
  message: string;
  statusCode?: number;
}

// src/modules/users/user.errors.ts

export const UserErrors = {
  NotFound: (id: string): AppError => ({
    code: "USER_NOT_FOUND",
    message: `User with id ${id} not found`,
    statusCode: 404,
  }),

  EmailExists: (email: string): AppError => ({
    code: "EMAIL_EXISTS",
    message: `User with email ${email} already exists`,
    statusCode: 409,
  }),

  InvalidCredentials: (): AppError => ({
    code: "INVALID_CREDENTIALS",
    message: "Invalid email or password",
    statusCode: 401,
  }),
} as const;
```

### Using Result in Services

```typescript
// src/modules/users/user.service.ts

import { Result } from "@/shared/result";
import { UserErrors } from "./user.errors";
import type { User, CreateUserRequest } from "./user.types";

export class UserService {
  constructor(private readonly userRepository: UserRepository) {}

  async createUser(request: CreateUserRequest): Promise<Result<User>> {
    // Check if email exists
    const exists = await this.userRepository.existsByEmail(request.email);
    if (exists) {
      return Result.fail(UserErrors.EmailExists(request.email));
    }

    // Create user
    const user = await this.userRepository.save({
      email: request.email,
      name: request.name,
      createdAt: new Date(),
    });

    return Result.ok(user);
  }

  async findById(id: string): Promise<Result<User>> {
    const user = await this.userRepository.findById(id);
    if (!user) {
      return Result.fail(UserErrors.NotFound(id));
    }
    return Result.ok(user);
  }
}
```

## Custom Exception Classes

For unexpected errors and infrastructure failures, use exception classes:

```typescript
// src/shared/errors/exceptions.ts

export class AppException extends Error {
  constructor(
    message: string,
    public readonly code: string,
    public readonly statusCode: number = 500,
    public readonly isOperational: boolean = true,
    public readonly details?: Record<string, unknown>
  ) {
    super(message);
    this.name = this.constructor.name;
    Error.captureStackTrace(this, this.constructor);
  }
}

export class NotFoundError extends AppException {
  constructor(resource: string, id: string) {
    super(`${resource} with id ${id} not found`, "NOT_FOUND", 404);
  }
}

export class ValidationError extends AppException {
  constructor(
    message: string,
    public readonly errors: Record<string, string[]>
  ) {
    super(message, "VALIDATION_ERROR", 400, true, { errors });
  }
}

export class UnauthorizedError extends AppException {
  constructor(message = "Unauthorized") {
    super(message, "UNAUTHORIZED", 401);
  }
}

export class ForbiddenError extends AppException {
  constructor(message = "Forbidden") {
    super(message, "FORBIDDEN", 403);
  }
}

export class ConflictError extends AppException {
  constructor(message: string) {
    super(message, "CONFLICT", 409);
  }
}
```

## Express Error Middleware

```typescript
// src/shared/middleware/error-handler.ts

import type { Request, Response, NextFunction, ErrorRequestHandler } from "express";
import { AppException } from "@/shared/errors/exceptions";
import { logger } from "@/shared/logger";
import type { ProblemDetail } from "@/shared/types";

export const errorHandler: ErrorRequestHandler = (
  error: Error,
  req: Request,
  res: Response,
  _next: NextFunction
): void => {
  // Log error
  logger.error({
    err: error,
    method: req.method,
    path: req.path,
    correlationId: req.headers["x-correlation-id"],
  });

  // Handle known operational errors
  if (error instanceof AppException && error.isOperational) {
    const problemDetail: ProblemDetail = {
      type: `https://api.example.com/errors/${error.code.toLowerCase()}`,
      title: error.name,
      status: error.statusCode,
      detail: error.message,
      instance: req.path,
      ...(error.details && { ...error.details }),
    };

    res.status(error.statusCode).json(problemDetail);
    return;
  }

  // Handle Zod validation errors
  if (error.name === "ZodError") {
    const zodError = error as import("zod").ZodError;
    const problemDetail: ProblemDetail = {
      type: "https://api.example.com/errors/validation-error",
      title: "Validation Error",
      status: 400,
      detail: "One or more fields are invalid",
      instance: req.path,
      errors: zodError.flatten().fieldErrors,
    };

    res.status(400).json(problemDetail);
    return;
  }

  // Handle unexpected errors - don't expose details
  const problemDetail: ProblemDetail = {
    type: "https://api.example.com/errors/internal-error",
    title: "Internal Server Error",
    status: 500,
    detail: "An unexpected error occurred. Please try again later.",
    instance: req.path,
  };

  res.status(500).json(problemDetail);
};
```

## Fastify Error Handler

```typescript
// src/shared/errors/fastify-error-handler.ts

import type { FastifyError, FastifyReply, FastifyRequest } from "fastify";
import { AppException } from "@/shared/errors/exceptions";

export function errorHandler(
  error: FastifyError,
  request: FastifyRequest,
  reply: FastifyReply
): void {
  request.log.error(error);

  if (error instanceof AppException && error.isOperational) {
    reply.status(error.statusCode).send({
      type: `https://api.example.com/errors/${error.code.toLowerCase()}`,
      title: error.name,
      status: error.statusCode,
      detail: error.message,
      instance: request.url,
    });
    return;
  }

  // Fastify validation error
  if (error.validation) {
    reply.status(400).send({
      type: "https://api.example.com/errors/validation-error",
      title: "Validation Error",
      status: 400,
      detail: "One or more fields are invalid",
      instance: request.url,
      errors: error.validation,
    });
    return;
  }

  reply.status(500).send({
    type: "https://api.example.com/errors/internal-error",
    title: "Internal Server Error",
    status: 500,
    detail: "An unexpected error occurred",
    instance: request.url,
  });
}
```

